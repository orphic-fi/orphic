# RPC endpoint for HyperEVM (chain id 999). Public default is fine for dry-run.
RPC_URL=https://rpc.hyperliquid.xyz/evm

# Private key of the agent EOA that is registered as allocator on the senior vault.
# NOT required for dry-run. Never commit a real value. Rotate as described in README.
AGENT_PRIVATE_KEY=

# Set to 1 to allow broadcasting. Anything else means dry-run.
LIVE=0

# Optional: where plans and reports are written (defaults to ./ops inside the keeper).
# OPS_DIR=./ops

# Optional: path to a JSON fixture describing the vault state, used when the vault
# addresses in config/senior.json are still placeholders.
# STATE_FIXTURE=test/fixtures/state.json
